{
  "name": "deepheart-desktop",
  "productName": "Deepheart",
  "version": "0.1.0",
  "private": true,
  "description": "Deepheart as a desktop app (Electron), for Steam and for playing offline.",
  "main": "main.cjs",
  "scripts": {
    "start": "npm --prefix .. run build && electron .",
    "dist:mac": "npm --prefix .. run build && electron-builder --mac",
    "dist:win": "npm --prefix .. run build && electron-builder --win",
    "dist:linux": "npm --prefix .. run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.jamesurobertson.deepheart",
    "productName": "Deepheart",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "game"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "artifactName": "Deepheart-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "Deepheart-${version}-windows-setup.${ext}",
      "oneClick": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
